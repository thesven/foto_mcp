{
  "name": "foto_mcp",
  "version": "2.0.0",
  "description": "An MCP (Model Context Protocol) server for Foto App",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "foto-mcp": "./dist/index.js",
    "foto_mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "tags.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "NODE_ENV=test FOTO_MCP_TEST=true c8 --check-coverage --lines 90 --statements 90 --functions 90 tsx test/test.ts",
    "test:coverage": "NODE_ENV=test FOTO_MCP_TEST=true c8 --reporter=html --reporter=text tsx test/test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesven/foto_mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "foto",
    "foto-app",
    "photography",
    "exif"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "c8": "^10.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
